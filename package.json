{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "geoji-web",
	"description": "거지방 AI 총무 웹 프론트엔드. 지출을 자진 신고하면 AI 총무가 판결하는 무지출 챌린지 서비스",
	"version": "1.0.0",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"homepage": "https://geoji-yaho.github.io/geoji-web/",
	"repository": {
		"type": "git",
		"url": "https://github.com/geoji-yaho/geoji-web"
	},
	"contributors": [
		{
			"name": "여찬규",
			"email": "dev.cgyeo@gmail.com",
			"url": "https://github.com/chan9yu"
		}
	],
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": "24.x",
		"pnpm": "11.x"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"check": "pnpm type:check && pnpm build && pnpm lint && pnpm format:check",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"type:check": "tsc -b --noEmit",
		"link:agents": "bash .agents/scripts/link-agents.sh",
		"prepare": "lefthook install && pnpm link:agents"
	},
	"dependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.1",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.5",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"globals": "^17.12.0",
		"lefthook": "^2.1.12",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2"
	}
}
